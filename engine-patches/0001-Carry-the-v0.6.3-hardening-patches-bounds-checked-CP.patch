+					uint32 nFileCRC;
+					uint16 nMetaDataSize;
+					Q_memcpy( &nFileCRC, pAfterName, sizeof( nFileCRC ) );
+					Q_memcpy( &nMetaDataSize, pAfterName + sizeof( uint32 ), sizeof( nMetaDataSize ) );
+					V_snprintf( pszFNameOut, sizeof( pszFNameOut ), "%s%s%s crc=0x%x metadatasz=%d", pszCurDir, pData, pszCurExtension, nFileCRC, nMetaDataSize );
+					// part descriptors until the PACKFILEINDEX_END terminator
+					char const *pPart = pAfterName + sizeof( uint32 ) + sizeof( uint16 );
+					while ( pPart + sizeof( CFilePartDescr ) <= pTreeEnd )
+					{
+						uint16 nFileNumber;
+						Q_memcpy( &nFileNumber, pPart, sizeof( nFileNumber ) );
+						if ( nFileNumber == PACKFILEINDEX_END )
+							break;
+						uint32 nFileDataOffset, nFileDataSize;
+						Q_memcpy( &nFileDataOffset, pPart + sizeof( uint16 ), sizeof( nFileDataOffset ) );
+						Q_memcpy( &nFileDataSize, pPart + sizeof( uint16 ) + sizeof( uint32 ), sizeof( nFileDataSize ) );
+						int nLen = V_strlen( pszFNameOut );
+						if ( (size_t)nLen >= sizeof( pszFNameOut ) )
+							break;
+						V_snprintf( pszFNameOut + nLen, sizeof( pszFNameOut ) - nLen," fnumber=%d ofs=0x%x sz=%d", nFileNumber, nFileDataOffset, nFileDataSize );
+						pPart += sizeof( CFilePartDescr );
 					}
 				}
 				else
@@ -1769,7 +1868,14 @@ int CPackedStore::GetFileList( const char *pWildCard, CUtlStringList &outFilenam
  					V_strncat( pszFNameOut, pData, sizeof( pszFNameOut ) );
  					V_strncat( pszFNameOut, pszCurExtension, sizeof( pszFNameOut ) );
 				}
-				SkipFile( pData );
+
+				char const *pNextEntry = NULL;
+				if ( !VpkSkipEntryBounded( pAfterName, pTreeEnd, &pNextEntry ) )
+				{
+					bTreeCorrupt = true;
+					break;
+				}
+				pData = pNextEntry;
 
 				bool matches = true;
 
@@ -1797,9 +1903,19 @@ int CPackedStore::GetFileList( const char *pWildCard, CUtlStringList &outFilenam
 					outFilenames.AddToTail( pFName );
 				}
 			}
+			if ( bTreeCorrupt )
+				break;
 			pData++;												// skip end marker
 		}
-		pData++;												// skip end marker
+		if ( bTreeCorrupt )
+			break;
