+// hsg100 v0.6.3 — bounds-checked directory-tree walking helpers.
+//
+// The FindFirst emulation (BuildFindFirstCache -> GetFileList) used to walk
+// the raw tree with unchecked strlen/sprintf into MAX_PATH stack buffers.
+// A truncated or corrupt archive made strlen run through the heap until it
+// hit a random NUL and FORTIFY killed the process:
+//   FORTIFY: vsprintf: prevented 77844-byte write into 260-byte buffer
+//   SIGABRT  CPackedStore::GetFileList <- BuildFindFirstCache <-
+//            GetFileAndDirLists <- CBaseFileSystem::FindFirstHelper <-
+//            Sys_FindFirst <- CServerPlugin::LoadPlugins
+// The helpers below never read outside [p, pEnd); a corrupt tree now stops
+// the listing instead of the process.
+
+// Returns the pointer just past the NUL-terminated string at p, or NULL
+// when the string is not NUL-terminated inside [p, pEnd).
+static char const *VpkNextTreeString( char const *p, char const *pEnd )
+{
+	while ( p < pEnd && *p )
+		++p;
+	if ( p >= pEnd )
+		return NULL;
+	return p + 1;		// past the NUL
+}
+
+// Advances one directory entry (crc u32 + metasize u16 + part descriptors +
+// PACKFILEINDEX_END terminator u16 + preload bytes). pEntry points at the
+// first byte AFTER the entry's name string. Returns false when the entry
+// is truncated inside [pEntry, pEnd); on success *ppOut is the next entry.
+static bool VpkSkipEntryBounded( char const *pEntry, char const *pEnd, char const **ppOut )
+{
+	if ( pEntry + sizeof( uint32 ) + sizeof( uint16 ) > pEnd )
+		return false;
+
+	uint16 nMetaDataSize;
+	Q_memcpy( &nMetaDataSize, pEntry + sizeof( uint32 ), sizeof( uint16 ) );
+
+	char const *p = pEntry + sizeof( uint32 ) + sizeof( uint16 );
+	while ( p + sizeof( PackFileIndex_t ) <= pEnd
+		 && Q_memcmp( p, &packedfileindex_end, sizeof( packedfileindex_end ) ) != 0 )
+	{
+		p += sizeof( CFilePartDescr );
+	}
+	if ( p + sizeof( PackFileIndex_t ) > pEnd )		// no terminator inside the tree
+		return false;
+	p += sizeof( PackFileIndex_t );
+	if ( p + nMetaDataSize > pEnd )					// preload runs past the tree
+		return false;
+
+	*ppOut = p + nMetaDataSize;
+	return true;
+}
+
 int CPackedStore::GetFileList( CUtlStringList &outFilenames, bool bFormattedOutput, bool bSortedOutput )
 {
 	return GetFileList( NULL, outFilenames, bFormattedOutput, bSortedOutput );
@@ -1729,38 +1781,85 @@ int CPackedStore::GetFileList( const char *pWildCard, CUtlStringList &outFilenam
 	}
 
